# Edge Init Container - TUF File Verifier for Edge Deployments
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the edge init application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o edge-init ./cmd/edge-init

# Final stage - minimal security-focused image
FROM alpine:latest

# Install security updates and required tools
RUN apk --no-cache add \
    ca-certificates \
    wget \
    && adduser -D -s /bin/sh -u 65534 tuf-user

WORKDIR /app

# Copy the binary
COPY --from=builder /app/edge-init /usr/local/bin/edge-init

# Create required directories
RUN mkdir -p /shared /cache /config && \
    chown -R tuf-user:tuf-user /shared /cache /config

# Security: Run as non-root user
USER tuf-user

# Default configuration
ENV TUF_SERVER_URL=""
ENV TUF_ROOT_KEYS_PATH="/config/root.json"
ENV TUF_TARGET_DIR="/shared"
ENV TUF_CACHE_DIR="/cache"
ENV TUF_LOG_LEVEL="info"
ENV TUF_TIMEOUT="300s"
ENV TUF_RETRY_ATTEMPTS="3"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD [ -f "/shared/.tuf-init-complete" ] || exit 1

# Volume for sharing files with main application container
VOLUME ["/shared", "/cache"]

# Default command
ENTRYPOINT ["/usr/local/bin/edge-init"]
CMD ["--verify-all", "--one-shot"]