# Multi-stage build for TUF Demo
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o tuf-demo ./cmd/tuf-demo

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates
WORKDIR /root/

# Copy the binary
COPY --from=builder /app/tuf-demo .

# Create directory for repository
RUN mkdir -p /app/tuf-repository

WORKDIR /app

# Expose volume for persistent storage
VOLUME ["/app/tuf-repository"]

# Run the application
CMD ["../root/tuf-demo"]