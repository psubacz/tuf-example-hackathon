# Multi-stage build for Add Targets utility
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o add-targets ./cmd/add-targets-demo

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates
WORKDIR /root/

# Copy the binary
COPY --from=builder /app/add-targets .

WORKDIR /app

# Expose volume for repository access
VOLUME ["/app/tuf-repository"]

# Run the application
CMD ["../root/add-targets"]