{
  "port": 8080,
  "host": "0.0.0.0",
  "repository_path": "./tuf-repository",
  "read_timeout": 30,
  "write_timeout": 30,
  "idle_timeout": 60,
  "log_level": "info",
  "log_format": "text",
  
  "tls": {
    "enabled": false,
    "cert_file": "/app/config/server.crt",
    "key_file": "/app/config/server.key",
    "auto_tls": false
  },
  
  "cors": {
    "enabled": true,
    "allowed_origins": ["*"],
    "allowed_methods": ["GET", "OPTIONS"],
    "allowed_headers": ["Content-Type", "Authorization"],
    "exposed_headers": [],
    "allow_credentials": false,
    "max_age": 3600
  },
  
  "rate_limit": {
    "enabled": true,
    "requests": 1000,
    "window": "1h",
    "burst_size": 100,
    "ip_whitelist": [],
    "ip_blacklist": []
  },
  
  "compression": {
    "enabled": true,
    "level": 6,
    "min_size": 1024,
    "types": [
      "application/json",
      "text/html",
      "text/plain",
      "text/css",
      "application/javascript"
    ]
  },
  
  "cache": {
    "enabled": true,
    "ttl": "5m",
    "max_size": 100,
    "cleanup_freq": "10m"
  },
  
  "metrics": {
    "enabled": true,
    "path": "/metrics"
  }
}