# Multi-stage build for TUF Client v2 (go-tuf v2)
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application with optimizations
RUN CGO_ENABLED=0 GOOS=linux go build \
    -a -installsuffix cgo \
    -ldflags="-w -s" \
    -o tuf-client ./cmd/tuf-client

# Final stage - using distroless for security
FROM gcr.io/distroless/static:nonroot

WORKDIR /app

# Copy CA certificates and binary
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /app/tuf-client /usr/local/bin/tuf-client

# Create directories with proper permissions
USER 65532:65532

# Labels for better metadata
LABEL maintainer="TUF Project" \
      version="2.0.0" \
      description="TUF Client using go-tuf v2 updater" \
      org.opencontainers.image.title="TUF Client v2" \
      org.opencontainers.image.description="Production-grade TUF client using official go-tuf v2 library" \
      org.opencontainers.image.version="2.0.0"

# Expose volumes for cache and repository access
VOLUME ["/app/tuf-client-v2-cache", "/app/tuf-repository-v2"]

# Environment variables for configuration
ENV TUF_SERVER_URL=http://tuf-server:8080 \
    TUF_CACHE_DIR=/app/tuf-client-v2-cache \
    TUF_REPOSITORY_PATH=/app/tuf-repository-v2

# Run as non-root user for security
USER 65532:65532

# Use the go-tuf v2 client
ENTRYPOINT ["/usr/local/bin/tuf-client"]
CMD ["--server", "http://tuf-server:8080", "--cache", "/app/tuf-client-v2-cache", "--repo", "/app/tuf-repository-v2"]