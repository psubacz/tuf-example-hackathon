# Multi-stage build for TUF Client Demo
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o tuf-client ./cmd/tuf-client-demo

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates
WORKDIR /root/

# Copy the binary
COPY --from=builder /app/tuf-client .

# Create directory for client cache
RUN mkdir -p /app/client-cache

WORKDIR /app

# Expose volume for cache
VOLUME ["/app/client-cache"]

# Run the application
CMD ["../root/tuf-client"]