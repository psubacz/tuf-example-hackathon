        TARGETS_META[targets.json<br/>🔐 Targets Signatures]
        SNAPSHOT_META[snapshot.json<br/>🔐 Snapshot Signature]
        TIMESTAMP_META[timestamp.json<br/>🔐 Timestamp Signature]
        
        ROOT_META --> TARGETS_META
