            SNAPSHOT[Snapshot Key<br/>Single Key<br/>Weekly Rotation]
            TIMESTAMP[Timestamp Key<br/>Single Key<br/>Daily Rotation]
        end
        
        subgraph "Delegated Keys"
            REGION1[Region 1 Keys<br/>1/2 Threshold]
            REGION2[Region 2 Keys<br/>1/2 Threshold]
            REGIONN[Region N Keys<br/>1/2 Threshold]
        end
        
        ROOT --> TARGETS
        ROOT --> SNAPSHOT
        ROOT --> TIMESTAMP
        TARGETS --> REGION1
        TARGETS --> REGION2
        TARGETS --> REGIONN
    end
    
    %% Metadata Chain
    subgraph "TUF Metadata Chain"
